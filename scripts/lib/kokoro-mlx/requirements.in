# The packages scripts/kokoro-mlx.sh installs, compiled for Apple silicon into requirements.txt with
# every version and hash fixed. After changing this file, run in this folder:
#   MACOSX_DEPLOYMENT_TARGET=14.0 uv pip compile requirements.in --override overrides.txt \
#     --python-platform aarch64-apple-darwin --python-version "$(cat .python-version)" \
#     --only-binary :all: --generate-hashes -o requirements.txt
# macOS 14 is the oldest MLX supports. Wheels only: building a package from source would fetch its
# build tools unpinned.
