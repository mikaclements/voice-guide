// The files Node runs, not the browser: the dev server's config, its stand-in for a product's
// server, and the tests, which `node --test` runs. Only they get Node's types, so the page can't use
// an API the browser lacks.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["vite.config.ts", "vite.config.client.ts", "dev", "src/**/*.test.ts"],
  "exclude": []
}
