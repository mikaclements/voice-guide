# Settings for local development. scripts/lib/env.sh copies this file to .env (which git ignores)
# on first use and fills in a fresh VOICE_TICKET_KEY.
# The one workspace and the placeholder user, until logins exist.
VOICE_WORKSPACE_ID=01a1de8b-bba7-7000-bad0-e92247a30f0f
# Signs the tickets the browser holds, one per session
VOICE_TICKET_KEY=
